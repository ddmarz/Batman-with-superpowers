#!/usr/bin/env bash
# Begin one task of a guided plan execution in a single call:
#   - extract the task's brief (shared with executing-plans and SDD);
#   - photograph the working tree (guided-snapshot): that tree is BASE, so
#     guided-task-done can show this task's changes alone even when earlier
#     tasks are still uncommitted. BASE is kept in <workspace>/task-N-base:
#     starting the same task again (after a compaction, in a new session)
#     reprints it instead of taking a new snapshot, so work done before the
#     restart stays in the task's diff;
#   - say whether an earlier guided task's work is still uncommitted, so the
#     agent can tell its human partner in one line. Only files some guided
#     task changed count (from the task-*.diff files): the uncommitted plan
#     file or a stray note is not a task waiting for its commit;
#   - make sure guided mode is on: the <workspace>/guided marker (holding the
#     plan path) is what hooks/guided-commit-guard looks for before denying
#     the agent's `git commit`. Reports go in <workspace>/reports/.
#
# Usage: guided-task-start PLAN_FILE TASK_NUMBER
# Prints:
#   brief: <path to the task's brief file>
#   base: <tree SHA: the working tree when the task first started>
#   uncommitted: yes|no
#   resumed: yes|no
set -euo pipefail

if [ $# -ne 2 ]; then
  echo "usage: guided-task-start PLAN_FILE TASK_NUMBER" >&2
  exit 2
fi

plan=$1
n=$2
here="$(cd "$(dirname "$0")" && pwd)"
sdd="$(cd "$here/../../subagent-driven-development/scripts" && pwd)"

repo=$("${BASH:-bash}" "$sdd/sdd-repo" --with-commit)
out=$("${BASH:-bash}" "$sdd/task-brief" "$plan" "$n")
brief=$(printf '%s\n' "$out" | sed -n 's/^wrote \(.*\): [0-9][0-9]* lines$/\1/p')
[ -n "$brief" ] || { echo "task-brief did not report a path: $out" >&2; exit 1; }

dir=$("${BASH:-bash}" "$sdd/sdd-workspace" "$plan")
[ -e "$dir/guided" ] || printf '%s\n' "$plan" > "$dir/guided"
mkdir -p "$dir/reports"

# Files that earlier guided tasks changed, from their saved diffs (this
# task's own diff, if it was closed before, doesn't count).
guided_files=()
for d in "$dir"/task-*.diff; do
  [ -f "$d" ] || continue
  [ "$d" = "$dir/task-${n}.diff" ] && continue
  while IFS= read -r f; do
    guided_files+=("$f")
  done < <(sed -n 's|^diff --git a/\(.*\) b/.*$|\1|p' "$d")
done
uncommitted=no
if [ "${#guided_files[@]}" -gt 0 ] \
  && [ -n "$(git -C "$repo" status --porcelain -- "${guided_files[@]}")" ]; then
  uncommitted=yes
fi

base_file="$dir/task-${n}-base"
if [ -s "$base_file" ]; then
  IFS= read -r base < "$base_file"
  resumed=yes
else
  base=$("${BASH:-bash}" "$here/guided-snapshot")
  printf '%s\n' "$base" > "$base_file"
  resumed=no
fi

echo "brief: $brief"
echo "base: $base"
echo "uncommitted: $uncommitted"
echo "resumed: $resumed"
